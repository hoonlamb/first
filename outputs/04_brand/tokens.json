{
  "meta": {
    "name": "댕큐 DANGQ design tokens",
    "version": "1.0.0",
    "updated": "2026-09-30",
    "mirrors": "app/src/styles/tokens.css (CSS is what ships; keep both in sync)",
    "artDirection": "AD2 나란히 두 선 — outputs/04_brand/art-direction/decision.md",
    "contrastMethod": "WCAG 2.x relative luminance, rounded to 2 decimals. AA = 4.5:1 body text, 3:1 large text (≥24px or ≥19px bold) and UI graphics."
  },
  "color": {
    "ink":          { "value": "#15201A", "role": "길(asphalt). 브랜드 순간의 바탕, 페이퍼 위 본문 글자", "contrast": { "paper": 14.85, "paper-2": 13.08, "signal": 5.86, "moss": 9.92 } },
    "ink-2":        { "value": "#24302A", "role": "잉크 위의 한 단 올린 면(카드·무대)", "contrast": { "paper": 12.16, "signal": 4.80, "moss": 8.12, "muted-on-ink": 6.36 } },
    "ink-3":        { "value": "#3A4740", "role": "잉크 위 헤어라인·비활성 테두리. 글자 금지", "contrast": { "ink": 1.72 } },
    "paper":        { "value": "#F4F1EA", "role": "낮(daylight). 제품 기본 바탕", "contrast": { "ink": 14.85 } },
    "paper-2":      { "value": "#E8E3D7", "role": "페이퍼 위 가라앉은 면·카드", "contrast": { "ink": 13.08, "muted": 4.94, "signal-ink": 4.49 } },
    "paper-3":      { "value": "#D6CFBF", "role": "페이퍼 위 헤어라인. 글자 금지", "contrast": { "paper": 1.38 } },
    "signal":       { "value": "#FF6A2B", "role": "상대·주의. 면 채움, 또는 잉크 위 글자만. 위에 얹는 글자는 잉크만", "contrast": { "ink": 5.86, "ink-2": 4.80, "white": 2.86, "paper": 2.53 } },
    "signal-ink":   { "value": "#B83A0A", "role": "페이퍼 위에서 쓰는 시그널 글자", "contrast": { "paper": 5.10, "paper-2": 4.49 } },
    "moss":         { "value": "#9FD3B2", "role": "편안·가까워짐. 잉크 위에서만 글자로", "contrast": { "ink": 9.92, "ink-2": 8.12, "paper": 1.50 } },
    "moss-ink":     { "value": "#1F6B45", "role": "페이퍼 위에서 쓰는 모스 글자", "contrast": { "paper": 5.73, "paper-2": 5.05 } },
    "muted":        { "value": "#58625C", "role": "페이퍼 위 보조 글자", "contrast": { "paper": 5.61, "paper-2": 4.94 } },
    "muted-on-ink": { "value": "#A9B3AD", "role": "잉크 위 보조 글자", "contrast": { "ink": 7.77, "ink-2": 6.36 } },
    "state-calm":   { "value": "#1F6B45", "role": "상태: 편안했어요 (항상 글자 라벨과 함께)", "contrast": { "paper": 5.73 } },
    "state-alert":  { "value": "#8A5A00", "role": "상태: 긴장했어요 (항상 글자 라벨과 함께)", "contrast": { "paper": 5.25 } },
    "state-react":  { "value": "#B3261E", "role": "상태: 반응했어요·오류 (항상 글자 라벨과 함께)", "contrast": { "paper": 5.79 } }
  },
  "rules": [
    "signal 위 글자는 ink만. 흰색(2.86:1)·paper(2.53:1) 글자 금지.",
    "페이퍼 위에서 시그널·모스를 글자로 쓸 때는 signal-ink·moss-ink로 바꾼다.",
    "상태 색(편안·긴장·반응)은 단독으로 의미를 전달하지 않는다. 항상 글자 라벨을 붙인다.",
    "강한 색원은 한 화면에 하나. signal 면은 한 화면에 한 곳.",
    "ink-3, paper-3은 선 전용. 글자에 쓰지 않는다."
  ],
  "type": {
    "family": "Pretendard Variable (SIL OFL 1.1), fallback: Pretendard, -apple-system, Apple SD Gothic Neo, Noto Sans KR, sans-serif",
    "scale": {
      "display": { "size": "clamp(56px, 11vw, 168px)", "weight": 880, "tracking": "-0.055em", "lineHeight": 1.02 },
      "h1":      { "size": "clamp(34px, 5.2vw, 64px)", "weight": 800, "tracking": "-0.045em", "lineHeight": 1.12 },
      "h2":      { "size": "clamp(26px, 3.4vw, 40px)", "weight": 800, "tracking": "-0.03em", "lineHeight": 1.15 },
      "h3":      { "size": "21px", "weight": 800, "tracking": "-0.03em", "lineHeight": 1.3 },
      "body":    { "size": "17px", "weight": 400, "tracking": "0", "lineHeight": 1.6 },
      "small":   { "size": "14px", "weight": 600, "tracking": "0", "lineHeight": 1.5 },
      "eyebrow": { "size": "14px", "weight": 800, "tracking": "0.04em", "lineHeight": 1.4 }
    },
    "numbers": { "fontVariantNumeric": "tabular-nums", "tracking": "-0.045em", "unit": "m, 숫자와 붙여 쓴다 (8m)" },
    "tracking": { "tight": "-0.045em", "head": "-0.03em" },
    "wordBreak": "keep-all"
  },
  "space": { "s1": "4px", "s2": "8px", "s3": "12px", "s4": "16px", "s5": "24px", "s6": "32px", "s7": "48px", "s8": "64px", "s9": "96px", "s10": "144px" },
  "layout": { "gutter": "clamp(16px, 4vw, 48px)", "max": "1200px", "columns": 12, "tap": "48px (최소 44px)" },
  "radius": { "r-s": "8px", "r-m": "14px", "r-l": "24px", "r-pill": "999px" },
  "stroke": { "lane": "6px (1000 단위 무대 기준. 로고는 마크 높이의 1/6)", "icon": "2.4px @ 26×20" },
  "motion": {
    "ease":      { "value": "cubic-bezier(.2,.7,.2,1)", "use": "나란히 — 함께 움직이는 요소, 등장" },
    "ease-step": { "value": "cubic-bezier(.65,0,.35,1)", "use": "순서 — 단계 전환, 걷는 다리" },
    "t-fast":    { "value": "160ms", "use": "버튼·칩 피드백" },
    "t-base":    { "value": "260ms", "use": "자세 변화, 거리 변화" },
    "t-slow":    { "value": "520ms", "use": "화면 등장, 결과 표시" },
    "tween":     { "value": "420ms ease-out cubic", "use": "거리 숫자·선 간격 (lib/motion.ts useTween)" },
    "reducedMotion": "prefers-reduced-motion: reduce → 모든 duration 0ms, 걷기 반복 애니메이션 정지, 숫자 즉시 변경"
  },
  "sound": { "value": "none", "reason": "야외·주변에 사람과 개가 있는 상황에서 쓰는 도구. 알림음이 개를 놀라게 해서는 안 된다." }
}
